{
  "name": "topo",
  "version": "2.0.0",
  "private": true,
  "description": "Topo - architecture diagrams from YAML",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "build": "node tools/topo.js build examples/demo-project",
    "serve": "node tools/topo.js serve",
    "package": "node tools/topo.js package",
    "vendor:yaml": "esbuild node_modules/yaml/browser/index.js --bundle --format=iife --global-name=YAML --minify --footer:js=try{module.exports=YAML}catch(e){} --outfile=vendor/yaml.js"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "yaml": "^2.9.1"
  }
}
